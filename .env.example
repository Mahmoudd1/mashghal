# Copy to .env and fill in. docker compose reads it automatically.
# Nothing here has a working default: the app refuses to start in prod on the
# development values committed to this repository.

# --- database ---
POSTGRES_DB=apparel
POSTGRES_USER=apparel
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- application ---
# Signing key for session tokens. At least 32 bytes.
# Generate: openssl rand -base64 48
APP_JWT_SECRET=

# The first account created on an empty database. It is an OWNER — the only role
# that sees purchase prices. Change the password after the first sign-in.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# Optional
# APP_JWT_TTL=PT12H
# APP_LOG_LEVEL=INFO
# APP_PORT=8080
